# Discord Bot Token (von https://discord.com/developers/applications)
DISCORD_TOKEN=dein_discord_token_hier

# Ollama – wird von setup.sh automatisch gesetzt
OLLAMA_HOST=http://127.0.0.1:11434
# llama3 (Server ~4.7 GB) | llama3.2:3b (~2 GB, Handy/Termux) | llama3.2:1b (~1.3 GB)
OLLAMA_MODEL=llama3

# Sprachnachrichten (1 = an, 0 = aus). Auf Termux automatisch 0.
WHATSAPP_VOICE=1
